# ── Runtime ───────────────────────────────────────────────────────────────
# development | production | test
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────
# Local dev (SQLite). In production use PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./nutrition.db

# ── Secrets (REQUIRED in production, >= 32 random chars) ──────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── Session cookie ────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
# strict (same site deployment, recommended) | lax | none (cross-site, needs HTTPS)
COOKIE_SAMESITE=strict
# Forced to true when ENVIRONMENT=production
COOKIE_SECURE=false

# ── Network ───────────────────────────────────────────────────────────────
# Origins allowed to call the API with credentials (comma separated, no trailing slash)
CORS_ORIGINS=http://localhost:4200
# Host header allow-list (comma separated). Use your real domain(s) in production.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Set to true ONLY when running behind a reverse proxy you control (nginx/Caddy)
TRUST_PROXY=false

# ── Uploads ───────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ── Business rules ────────────────────────────────────────────────────────
ORDER_PREFIX=NS
MAX_QTY_PER_LINE=20

# ── First admin (used by scripts/create_admin.py) ─────────────────────────
# Leave ADMIN_PASSWORD empty to have a strong one generated and printed once.
ADMIN_EMAIL=
ADMIN_PASSWORD=
