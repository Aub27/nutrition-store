# Copy to ".env" next to docker-compose.yml. NEVER commit the real .env file.

# Your public domain (DNS A/AAAA record must already point at the server)
DOMAIN=shop.example.com

# Database. Use a long random value WITHOUT special URL characters:  openssl rand -hex 24
POSTGRES_USER=nutrition
POSTGRES_DB=nutrition
POSTGRES_PASSWORD=

# JWT signing key (>= 32 chars):  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Admin session length in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Prefix of customer-facing order numbers (e.g. NS-7K2M9QXA)
ORDER_PREFIX=NS

# Used only by: docker compose exec backend python scripts/create_admin.py
# Leave ADMIN_PASSWORD empty to get a generated one printed once.
ADMIN_EMAIL=
ADMIN_PASSWORD=
